# Copier en `.env` À CÔTÉ de ce fichier, puis remplir. `.env` est ignoré par git.
#
#   cp tools/monitor/.env.example tools/monitor/.env

# Le projet. Visible dans le tableau de bord Supabase, rien de secret.
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co

# La clé publiable — la MÊME que celle embarquée dans l'app iOS. Elle est
# publique par construction : tout son pouvoir est ce que les politiques RLS lui
# laissent. Ce n'est PAS `service_role`, qui n'a rien à faire sur un Pi.
SUPABASE_ANON_KEY=

# Le seul vrai secret d'ici. À générer une fois :
#
#   openssl rand -base64 32
#
# puis à poser des DEUX côtés — sinon la fonction refuse (401) ou n'est pas
# configurée (503), et le moniteur le dira :
#
#   supabase secrets set MONITOR_TOKEN='…'     # côté serveur
#   MONITOR_TOKEN=…                            # ici, côté Pi
#
# Tout son pouvoir est de demander « combien » à la fonction `metrics`, qui
# n'agrège que des nombres. Le perdre ne donne accès à aucun nom, aucun titre,
# et à rien d'écrivable.
MONITOR_TOKEN=

# Facultatif — cadence de rafraîchissement de la page, en secondes.
# REFRESH_SECONDS=30

# Facultatif — n'écouter que sur une interface plutôt que sur toutes.
# HOST=0.0.0.0
# PORT=4322
