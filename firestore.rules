rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /poi/{document=**} {
      allow read: if true;
      allow write: if false;
    }
    match /cheats/{document=**} {
      allow read: if true;
      allow write: if false;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
