    "cheats.code.phone.hint": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Im Spiel-Handy wählen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Dial on the in-game phone"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Márcalo en el teléfono del juego"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À composer sur le téléphone du jeu"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Da comporre sul telefono di gioco"
          }
        }
      }
    },
    "cheats.empty.body": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Spiel erscheint am 19. November 2026. Seine Codes kommen hierher, sobald Spieler sie gefunden und bestätigt haben — wir raten sie nicht vorab."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The game is out on 19 November 2026. Its codes will land here once players have found and confirmed them — we won’t guess them in advance."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El juego sale el 19 de noviembre de 2026. Sus códigos llegarán aquí cuando los jugadores los encuentren y confirmen: no los adivinaremos por adelantado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le jeu sort le 19 novembre 2026. Ses codes arriveront ici dès que les joueurs les auront trouvés et confirmés — nous ne les devinerons pas d’avance."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il gioco esce il 19 novembre 2026. I suoi codici arriveranno qui quando i giocatori li avranno trovati e confermati: non li indovineremo in anticipo."
          }
        }
      }
    },
    "cheats.empty.title": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch keine Codes"
          }
        },
        "en": {
