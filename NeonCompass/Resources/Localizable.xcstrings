    "disclaimer.body": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese App ist ein Fanprojekt. Sie steht in keiner Verbindung zu Rockstar Games oder Take-Two Interactive und wird von diesen weder unterstützt noch anerkannt. Alle Grafiken sind Originalwerke."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This app is a fan project. It is not affiliated with, endorsed by, or connected to Rockstar Games or Take-Two Interactive. All artwork is original."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta aplicación es un proyecto de fans. No está afiliada, respaldada ni conectada con Rockstar Games ni Take-Two Interactive. Todas las ilustraciones son originales."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette application est un projet de fan. Elle n'est ni affiliée à, ni approuvée par, ni liée à Rockstar Games ou Take-Two Interactive. Tous les visuels sont originaux."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa app è un progetto di fan. Non è affiliata, sponsorizzata né collegata a Rockstar Games o Take-Two Interactive. Tutti i contenuti grafici sono originali."
          }
        }
      }
    },
