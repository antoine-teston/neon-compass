    "profile.contribute.hint.message": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Halte auf der Karte genau dort gedrückt, wo der Ort liegt. Nach der Freigabe bringt er dir 20 XP und erscheint für alle."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On the map, press and hold exactly where the place is. Once a moderator approves it, you earn 20 XP and it appears for everyone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En el mapa, mantén pulsado justo donde está el lugar. Cuando se apruebe, ganarás 20 XP y aparecerá para todos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sur la carte, appuie longuement à l'endroit exact du lieu. Une fois validé par la modération, il te rapporte 20 XP et apparaît pour tout le monde."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sulla mappa, tieni premuto esattamente dove si trova il luogo. Una volta approvato, ti frutta 20 XP e appare per tutti."
          }
        }
      }
    },
