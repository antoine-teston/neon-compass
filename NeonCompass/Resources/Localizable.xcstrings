    "cheats.footnote.safe": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keiner dieser Codes verhindert 100 %. Die Wirkung endet, und das Spiel-Handy merkt sie sich nicht — zum Erneuern neu eingeben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "None of these codes block 100% completion. Their effect wears off, and the in-game phone doesn’t remember them — enter one again to renew it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ninguno de estos códigos impide el 100 %. Su efecto caduca y el teléfono del juego no los recuerda: vuelve a introducirlos para renovarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun de ces codes n’empêche le 100 %. Leur effet expire, et le téléphone du jeu ne les mémorise pas : à resaisir pour renouveler."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessuno di questi codici impedisce il 100 %. L’effetto scade e il telefono di gioco non li memorizza: reinseriscilo per rinnovarlo."
          }
        }
      }
    },
