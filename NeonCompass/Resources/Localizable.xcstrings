        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No necesitas una cuenta para explorar. Iniciar sesión solo sirve para la sincronización, las contribuciones y los votos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
